# ---- 构建产物：用脚本重新生成，不进版本库 ----
# Windows：build_windows.ps1    Android：build_android.ps1    成品：完善\打包成品.ps1
dist/
dist_onefile/
build/
build_onefile/
*.spec
完善/成品/

# ---- Python 缓存 ----
__pycache__/
*.pyc
.pytest_cache/

# ---- Flutter / Gradle 中间产物 ----
.dart_tool/

# ---- 签名密钥：绝对不能提交 ----
# 密钥库 + 口令一旦进了 GitHub，任何人都能签出"你的"更新包，署名就废了。
# 密钥库请自己另存一份（U 盘 / 私有云），丢了就再也发不了这个包名的更新。
签名密钥/
*.jks
*.keystore

# ---- 本地存档与临时文件 ----
# core\local_store.py 把草稿和答题记录存在这里，坏文件会留 .corrupt 档
.gs_it_exam/
*.tmp
*.corrupt
*.corrupt.*

# ---- 第三方教材原件：不进公开仓库 ----
# 资料\甘肃省信息技术学考指导.pdf 是出版社的公开出版物扫描件，版权归原出版方。
# 放进公开仓库等于替别人做了一次未授权分发，风险不该由这个项目承担。
# 自己留着学习用就好（文件仍在本地，只是不被 git 跟踪）。
资料/*.pdf

# ---- 编辑器 / 系统垃圾 ----
Thumbs.db
desktop.ini
.vscode/
.idea/
